// The package as published: the TypeScript sources compiled into dist, with their declarations.
// The runtime's JavaScript ships as it is written, so scripts/build.ts copies it instead. The
// page's modules are among the sources, so it sees the DOM's types and the framework's modules too.
{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"outDir": "dist",
		"rootDir": "src",
		"lib": ["es2024", "dom"],
		"types": ["node", "@sveltejs/kit", "vite/client"]
	},
	"include": ["src"],
	"exclude": ["src/runtime"]
}
