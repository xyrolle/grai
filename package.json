{
	"name": "grai",
	"version": "0.0.0",
	"description": "Translation catalogs compiled ahead of time into plain functions, for any JavaScript framework.",
	"keywords": [
		"i18n",
		"messageformat",
		"translation",
		"compiler"
	],
	"license": "MIT",
	"author": "Serghei",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xyrolle/grai.git"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"bin": {
		"grai": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepack": "pnpm build",
		"check": "biome check .",
		"typecheck": "tsc && tsc -p tsconfig.runtime.json",
		"test": "vitest run",
		"test:performance": "node scripts/performance.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@types/node": "24.19.2",
		"typescript": "7.0.2",
		"vitest": "5.0.5"
	}
}
