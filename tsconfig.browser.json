// The adapters' modules that run in the page, checked on their own: they see the DOM's types and
// the frameworks' own modules ($app/env, $app/navigation, vue).
{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"lib": ["es2024", "dom"],
		"types": ["@sveltejs/kit", "vite/client"]
	},
	"include": [
		"src/sveltekit-client.ts",
		"src/sveltekit-navigation.ts",
		"src/vue/client.ts"
	],
	"exclude": []
}
