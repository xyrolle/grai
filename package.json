{
	"name": "grai",
	"version": "0.0.0",
	"description": "Translation catalogs compiled ahead of time into plain functions, for any JavaScript framework.",
	"keywords": [
		"i18n",
		"messageformat",
		"translation",
		"compiler"
	],
	"license": "MIT",
	"author": "Serghei",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xyrolle/grai.git"
	},
	"type": "module",
	"sideEffects": [
		"./dist/sveltekit-client.js"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./vite": {
			"types": "./dist/vite.d.ts",
			"default": "./dist/vite.js"
		},
		"./register": {
			"types": "./dist/register.d.ts",
			"default": "./dist/register.js"
		},
		"./svelte": {
			"types": "./dist/svelte.d.ts",
			"default": "./dist/svelte.js"
		},
		"./next": {
			"types": "./dist/next/render.d.ts",
			"react-server": "./dist/next/render.js",
			"default": "./dist/next/provider.js"
		},
		"./next/config": {
			"types": "./dist/next/config.d.ts",
			"default": "./dist/next/config.js"
		},
		"./next/proxy": {
			"types": "./dist/next/proxy.d.ts",
			"default": "./dist/next/proxy.js"
		},
		"./react": {
			"types": "./dist/react/markup.d.ts",
			"default": "./dist/react/markup.js"
		},
		"./sveltekit": {
			"types": "./dist/sveltekit.d.ts",
			"default": "./dist/sveltekit.js"
		},
		"./sveltekit/vite": {
			"types": "./dist/sveltekit-vite.d.ts",
			"default": "./dist/sveltekit-vite.js"
		},
		"./sveltekit/client": {
			"types": "./dist/sveltekit-client.d.ts",
			"default": "./dist/sveltekit-client.js"
		},
		"./sveltekit/navigation": {
			"types": "./dist/sveltekit-navigation.d.ts",
			"default": "./dist/sveltekit-navigation.js"
		},
		"./astro": {
			"types": "./dist/astro.d.ts",
			"default": "./dist/astro.js"
		},
		"./astro/middleware": {
			"types": "./dist/astro/middleware.d.ts",
			"default": "./dist/astro/middleware.js"
		},
		"./astro/translated-paths": {
			"types": "./dist/astro/translated-paths.d.ts",
			"default": "./dist/astro/translated-paths.js"
		},
		"./vue": {
			"types": "./dist/vue/markup.d.ts",
			"default": "./dist/vue/markup.js"
		},
		"./vue/client": {
			"types": "./dist/vue/client.d.ts",
			"default": "./dist/vue/client.js"
		},
		"./nuxt": {
			"types": "./dist/nuxt/module.d.ts",
			"default": "./dist/nuxt/module.js"
		}
	},
	"bin": {
		"grai": "./dist/cli.js"
	},
	"files": [
		"dist",
		"config.schema.json"
	],
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"build": "node scripts/build.ts",
		"prepack": "pnpm build",
		"prepublishOnly": "pnpm check && pnpm typecheck && pnpm build && pnpm test && pnpm check:package && pnpm size",
		"check": "biome check . && pnpm check:bench-lockfile",
		"check:bench-lockfile": "pnpm --dir bench install --frozen-lockfile --lockfile-only",
		"typecheck": "tsc && tsc -p tsconfig.runtime.json && tsc -p tsconfig.browser.json",
		"test": "vitest run",
		"test:performance": "node scripts/performance.ts",
		"check:package": "publint run --strict && attw --pack . --profile esm-only",
		"size": "node scripts/size.ts"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^3.1.0",
		"astro": ">=7",
		"magic-string": ">=1",
		"next": ">=16.3",
		"nuxt": ">=4.6",
		"react": ">=19",
		"svelte": ">=5",
		"vite": ">=8",
		"vue": ">=3.5",
		"@mdx-js/mdx": ">=3"
	},
	"peerDependenciesMeta": {
		"@sveltejs/kit": {
			"optional": true
		},
		"astro": {
			"optional": true
		},
		"magic-string": {
			"optional": true
		},
		"next": {
			"optional": true
		},
		"nuxt": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"svelte": {
			"optional": true
		},
		"vite": {
			"optional": true
		},
		"vue": {
			"optional": true
		},
		"@mdx-js/mdx": {
			"optional": true
		}
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "0.18.5",
		"@biomejs/biome": "2.6.2",
		"@mdx-js/mdx": "3.1.1",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/jsdom": "30.0.0",
		"@types/node": "24.19.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-vue": "6.0.10",
		"astro": "7.4.2",
		"bun": "runtime:1.4.4",
		"cldr-core": "48.0.0",
		"deno": "runtime:2.9.6",
		"hono": "4.13.13",
		"jsdom": "30.1.3",
		"magic-string": "1.4.3",
		"next": "16.4.3",
		"nuxt": "4.6.2",
		"playwright-core": "1.64.1",
		"publint": "0.3.25",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"rolldown": "1.2.15",
		"svelte": "5.57.2",
		"typescript": "7.0.2",
		"vite": "8.3.5",
		"vitest": "5.0.5",
		"vue": "3.5.44",
		"wrangler": "4.152.0"
	},
	"dependencies": {
		"oxc-parser": "^0.155.0",
		"oxc-resolver": "^11.24.2"
	}
}
