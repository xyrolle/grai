{
	"name": "grai",
	"version": "0.0.0",
	"description": "Translation catalogs compiled ahead of time into plain functions, for any JavaScript framework.",
	"keywords": [
		"i18n",
		"messageformat",
		"translation",
		"compiler"
	],
	"license": "MIT",
	"author": "Serghei",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xyrolle/grai.git"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./vite": {
			"types": "./dist/vite.d.ts",
			"default": "./dist/vite.js"
		},
		"./next": {
			"types": "./dist/next/render.d.ts",
			"react-server": "./dist/next/render.js",
			"default": "./dist/next/provider.js"
		},
		"./next/config": {
			"types": "./dist/next/config.d.ts",
			"default": "./dist/next/config.js"
		},
		"./next/proxy": {
			"types": "./dist/next/proxy.d.ts",
			"default": "./dist/next/proxy.js"
		},
		"./react": {
			"types": "./dist/react/markup.d.ts",
			"default": "./dist/react/markup.js"
		}
	},
	"bin": {
		"grai": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepack": "pnpm build",
		"check": "biome check .",
		"typecheck": "tsc && tsc -p tsconfig.runtime.json",
		"test": "vitest run",
		"test:performance": "node scripts/performance.ts"
	},
	"peerDependencies": {
		"next": ">=16.3",
		"react": ">=19",
		"vite": ">=8"
	},
	"peerDependenciesMeta": {
		"next": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"vite": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@types/node": "24.19.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"cldr-core": "48.0.0",
		"next": "16.4.3",
		"playwright-core": "1.64.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"typescript": "7.0.2",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	}
}
