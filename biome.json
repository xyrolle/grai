{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**", "!**/pnpm-lock.yaml", "!**/*.md", "!**/src/app.html"]
	},
	"html": {
		"experimentalFullSupportEnabled": true
	},
	"overrides": [
		{
			"includes": ["examples/nuxt/app/pages/**"],
			"linter": {
				"rules": {
					"style": {
						"useVueMultiWordComponentNames": "off"
					}
				}
			}
		}
	]
}
