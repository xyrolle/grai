{
	"name": "sveltekit-example",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"build": "vite build",
		"preview": "node build",
		"typecheck": "grai compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo-experimental-api"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "6.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/node": "24.19.2",
		"@typescript/native": "npm:typescript@7.0.2",
		"grai": "workspace:*",
		"magic-string": "1.4.3",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"typescript": "6.0.3",
		"vite": "8.3.5"
	}
}
