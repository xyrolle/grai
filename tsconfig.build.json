// The package as published: the TypeScript sources compiled into dist, with their declarations.
// The runtime's JavaScript ships as it is written, so scripts/build.ts copies it instead.
{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"outDir": "dist",
		"rootDir": "src"
	},
	"include": ["src"],
	"exclude": ["src/runtime"]
}
