{
	"name": "grai",
	"version": "0.0.0",
	"description": "Translation catalogs compiled ahead of time into plain functions, for any JavaScript framework.",
	"keywords": [
		"i18n",
		"messageformat",
		"translation",
		"compiler"
	],
	"license": "MIT",
	"author": "Serghei",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xyrolle/grai.git"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./vite": {
			"types": "./dist/vite.d.ts",
			"default": "./dist/vite.js"
		},
		"./svelte": {
			"types": "./dist/svelte.d.ts",
			"default": "./dist/svelte.js"
		},
		"./vue": {
			"types": "./dist/vue/markup.d.ts",
			"default": "./dist/vue/markup.js"
		},
		"./vue/client": {
			"types": "./dist/vue/client.d.ts",
			"default": "./dist/vue/client.js"
		}
	},
	"bin": {
		"grai": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepack": "pnpm build",
		"check": "biome check .",
		"typecheck": "tsc && tsc -p tsconfig.runtime.json && tsc -p tsconfig.browser.json && pnpm --filter grai-example-vue typecheck",
		"test": "vitest run",
		"test:performance": "node scripts/performance.ts"
	},
	"peerDependencies": {
		"magic-string": ">=1",
		"svelte": ">=5",
		"vite": ">=8",
		"vue": ">=3.5"
	},
	"peerDependenciesMeta": {
		"magic-string": {
			"optional": true
		},
		"svelte": {
			"optional": true
		},
		"vite": {
			"optional": true
		},
		"vue": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/node": "24.19.2",
		"bun": "runtime:1.4.4",
		"cldr-core": "48.0.0",
		"deno": "runtime:2.9.6",
		"hono": "4.13.13",
		"magic-string": "1.4.3",
		"playwright-core": "1.64.1",
		"svelte": "5.57.2",
		"typescript": "7.0.2",
		"vite": "8.3.5",
		"vitest": "5.0.5",
		"vue": "3.5.44",
		"wrangler": "4.152.0"
	}
}
