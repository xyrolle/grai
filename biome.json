{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!**/pnpm-lock.yaml",
			"!**/*.md",
			"!**/src/app.html",
			"!bench/results"
		]
	},
	"html": {
		"experimentalFullSupportEnabled": true
	},
	"overrides": [
		{
			"includes": [
				"src/nuxt/**",
				"src/vue/**",
				"examples/vue/**",
				"examples/nuxt/**"
			],
			"linter": {
				"domains": {
					"react": "none"
				}
			}
		},
		{
			"includes": ["examples/nuxt/app/pages/**"],
			"linter": {
				"rules": {
					"style": {
						"useVueMultiWordComponentNames": "off"
					}
				}
			}
		}
	]
}
