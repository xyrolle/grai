{
	"name": "grai",
	"version": "0.0.0",
	"description": "Translation catalogs compiled ahead of time into plain functions, for any JavaScript framework.",
	"keywords": [
		"i18n",
		"messageformat",
		"translation",
		"compiler"
	],
	"license": "MIT",
	"author": "Serghei",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xyrolle/grai.git"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./vite": {
			"types": "./dist/vite.d.ts",
			"default": "./dist/vite.js"
		},
		"./svelte": {
			"types": "./dist/svelte.d.ts",
			"default": "./dist/svelte.js"
		},
		"./next": {
			"types": "./dist/next/render.d.ts",
			"react-server": "./dist/next/render.js",
			"default": "./dist/next/provider.js"
		},
		"./next/config": {
			"types": "./dist/next/config.d.ts",
			"default": "./dist/next/config.js"
		},
		"./next/proxy": {
			"types": "./dist/next/proxy.d.ts",
			"default": "./dist/next/proxy.js"
		},
		"./react": {
			"types": "./dist/react/markup.d.ts",
			"default": "./dist/react/markup.js"
		},
		"./sveltekit": {
			"types": "./dist/sveltekit.d.ts",
			"default": "./dist/sveltekit.js"
		},
		"./sveltekit/client": {
			"types": "./dist/sveltekit-client.d.ts",
			"default": "./dist/sveltekit-client.js"
		}
	},
	"bin": {
		"grai": "./dist/cli.js"
	},
	"files": [
		"dist",
		"config.schema.json"
	],
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "node scripts/build.ts",
		"prepack": "pnpm build",
		"check": "biome check .",
		"typecheck": "tsc && tsc -p tsconfig.runtime.json && tsc -p tsconfig.browser.json",
		"test": "vitest run",
		"test:performance": "node scripts/performance.ts",
		"check:package": "publint run --strict && attw --pack . --profile esm-only",
		"size": "node scripts/size.ts"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^3.1.0",
		"magic-string": ">=1",
		"next": ">=16.3",
		"react": ">=19",
		"svelte": ">=5",
		"vite": ">=8"
	},
	"peerDependenciesMeta": {
		"@sveltejs/kit": {
			"optional": true
		},
		"magic-string": {
			"optional": true
		},
		"next": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"svelte": {
			"optional": true
		},
		"vite": {
			"optional": true
		}
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "0.18.5",
		"@biomejs/biome": "2.6.2",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/node": "24.19.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"bun": "runtime:1.4.4",
		"cldr-core": "48.0.0",
		"deno": "runtime:2.9.6",
		"hono": "4.13.13",
		"magic-string": "1.4.3",
		"next": "16.4.3",
		"playwright-core": "1.64.1",
		"publint": "0.3.25",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"rolldown": "1.2.15",
		"svelte": "5.57.2",
		"typescript": "7.0.2",
		"vite": "8.3.5",
		"vitest": "5.0.5",
		"wrangler": "4.152.0"
	}
}
