{
	"name": "grai-example-vue",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node server.ts --dev",
		"build": "vite build --outDir dist/client && vite build --ssr src/entry-server.ts --outDir dist/server",
		"start": "node server.ts",
		"typecheck": "grai compile && vue-tsc --noEmit"
	},
	"devDependencies": {
		"@types/node": "24.19.2",
		"@vitejs/plugin-vue": "6.0.10",
		"grai": "workspace:*",
		"typescript": "6.0.3",
		"vite": "8.3.5",
		"vue": "3.5.44",
		"vue-tsc": "3.3.13"
	}
}
